# 9Router environment contract
# Vercel injects VERCEL=1 automatically. Do not set PORT/HOSTNAME on Vercel.

# Required production secrets
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt

# Production runtime
NODE_ENV=production
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=true
REQUIRE_API_KEY=true

# Public deployment URL
# Set both values to the final Vercel/custom domain.
BASE_URL=https://your-domain.example
NEXT_PUBLIC_BASE_URL=https://your-domain.example

# Cloud sync endpoint
CLOUD_URL=https://9router.com
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# Vercel filesystem note
# The app automatically uses /tmp/9router on Vercel. /tmp is ephemeral and is
# NOT durable storage for provider connections, OAuth tokens, settings or usage.
# DATA_DIR=/tmp/9router

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=https://your-searxng.example/search

# Optional: disable proactive interval-based refresh on long-running local/CLI runtimes.
# Vercel disables the process scheduler automatically when VERCEL=1; normal
# request-path token refresh remains independent of this scheduler.
# DISABLE_BACKGROUND_TOKEN_REFRESH=true
